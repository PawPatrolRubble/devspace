{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug DevSpace Serve",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "tsx",
        "src/cli.ts",
        "serve"
      ],
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    }
  ]
}
